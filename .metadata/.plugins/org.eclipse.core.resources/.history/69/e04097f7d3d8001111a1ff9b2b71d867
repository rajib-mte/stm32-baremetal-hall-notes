
#include "stm32f401xc.h"

volatile uint16_t adc_value = 0;
volatile float adc_voltage = 0.0f;

void GPIO_ADC_Init(void)
{
    // 1. Enable GPIOA clock
    RCC->AHB1ENR |= (1U << 0);

    // 2. Configure PA0 as Analog mode (MODER0 = 11)
    GPIOA->MODER &= ~(3U << 0);
    GPIOA->MODER |=  (3U << 0);

    // 3. Disable pull-up/pull-down
    GPIOA->PUPDR &= ~(3U << 0);
}

void ADC1_Init(void)
{
    // 1. Enable ADC1 peripheral clock
    RCC->APB2ENR |= (1U << 8);

    // 2. ADC prescaler = PCLK2 / 2
    // ADCPRE = 00
    ADC->CCR &= ~(3U << 16);

    // 3. Disable ADC before configuration
    ADC1->CR2 &= ~(1U << 0);

    // 4. Configure ADC resolution = 12 bits
    ADC1->CR1 &= ~(3U << 24);

    // 5. Disable scan mode
    ADC1->CR1 &= ~(1U << 8);

    // 6. Disable continuous conversion
    ADC1->CR2 &= ~(1U << 1);

    // 7. Right alignment
    ADC1->CR2 &= ~(1U << 11);

    // 8. Software trigger selection
    ADC1->CR2 &= ~(3U << 28);

    // 9. Disable external trigger
    ADC1->CR2 &= ~(3U << 28);
    ADC1->CR2 &= ~(1U << 20);

    // 10. Configure sampling time for Channel 0
    // 84 ADC cycles = SMP0: 100
    ADC1->SMPR2 &= ~(7U << 0);
    ADC1->SMPR2 |=  (4U << 0);

    // 11. One conversion in regular sequence
    ADC1->SQR1 &= ~(0xFU << 20);

    // 12. First conversion = Channel 0
    ADC1->SQR3 &= ~(0x1FU << 0);
    ADC1->SQR3 |=  (0U << 0);

    // 13. Enable ADC1
    ADC1->CR2 |= (1U << 0);
}

uint16_t ADC1_Read(void)
{
    // Start ADC conversion
    ADC1->CR2 |= (1U << 30);

    // Wait until End Of Conversion
    while (!(ADC1->SR & (1U << 1)))
    {
    }

    // Read ADC data register
    return (uint16_t)ADC1->DR;
}

int main(void)
{
    GPIO_ADC_Init();

    ADC1_Init();

    while (1)
    {
        // Read ADC value
        adc_value = ADC1_Read();

        // Convert digital value into voltage
        adc_voltage = (adc_value * 3.3f) / 4095.0f;
        HAL_Delay(100);
    }
}
