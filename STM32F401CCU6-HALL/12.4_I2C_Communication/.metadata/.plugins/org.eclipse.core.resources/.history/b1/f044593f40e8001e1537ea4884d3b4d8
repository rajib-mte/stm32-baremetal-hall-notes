void LCD_Init(void) {
    // Initialization sequence for 20x4 LCD
    HAL_Delay(50); // Wait for LCD power-up
    LCD_WriteCommand(0x02); // Return home
    HAL_Delay(5);
    LCD_WriteCommand(0x28); // Function set: 4-bit mode, 2 lines, 5x8 font
    HAL_Delay(1);
    LCD_WriteCommand(0x0C); // Display control: display on, cursor off, blink off
    HAL_Delay(1);
    LCD_WriteCommand(0x01); // Clear display
    HAL_Delay(2);
}

