#include "main.h"
//#include "hall.h" // Assuming you have a Hall library
#include "stdio.h" // For sprintf function

#define I2C_LCD_ADDRESS 0x27 // I2C address of the PCF8574 module
#define LCD_WIDTH 20
#define LCD_HEIGHT 4

// Function prototypes
void I2C_LCD_SendCommand(uint8_t command);
void I2C_LCD_SendData(uint8_t data);
void I2C_LCD_SendString(char *str);
void I2C_LCD_SetCursor(uint8_t row, uint8_t col);
void I2C_LCD_Clear(void);
void I2C_Init(void);

// HAL I2C handle declaration
I2C_HandleTypeDef hi2c1;

int main(void) {
    HAL_Init();
    I2C_Init();
    HAL_Delay(1000); // Delay to let the LCD initialize

    I2C_LCD_Clear();
    I2C_LCD_SendString("Hello, STM32!");
    I2C_LCD_SetCursor(1, 0);
    I2C_LCD_SendString("LCD with I2C");
    I2C_LCD_SetCursor(2, 0);
    I2C_LCD_SendString("PCF8574 Module");
    I2C_LCD_SetCursor(3, 0);
    I2C_LCD_SendString("Ready to go!");

    while (1) {
        // Your main code here
    }
}

void I2C_Init(void) {
    hi2c1.Instance = I2C1;
    hi2c1.Init.ClockSpeed = 100000; // I2C speed: 100 kHz
    hi2c1.Init.DutyCycle = I2C_DUTYCYCLE_2;
    hi2c1.Init.OwnAddress1 = 0;
    hi2c1.Init.AddressingMode = I2C_ADDRESSINGMODE_7BIT;
    hi2c1.Init.DualAddressMode = I2C_DUALADDRESS_DISABLE;
    hi2c1.Init.OwnAddress2 = 0;
    hi2c1.Init.GeneralCallMode = I2C_GENERALCALL_DISABLE;
    hi2c1.Init.NoStretchMode = I2C_NOSTRETCH_DISABLE;
    if (HAL_I2C_Init(&hi2c1) != HAL_OK) {
        Error_Handler();
    }
}

void I2C_LCD_SendCommand(uint8_t command) {
    HAL_StatusTypeDef status;
    status = HAL_I2C_Mem_Write(&hi2c1, I2C_LCD_ADDRESS, 0x00, 1, &command, 1, HAL_MAX_DELAY);
    if (status != HAL_OK) {
        Error_Handler();
    }
    HAL_Delay(2); // Command execution time
}

void I2C_LCD_SendData(uint8_t data) {
    HAL_StatusTypeDef status;
    status = HAL_I2C_Mem_Write(&hi2c1, I2C_LCD_ADDRESS, 0x40, 1, &data, 1, HAL_MAX_DELAY);
    if (status != HAL_OK) {
        Error_Handler();
    }
}

void I2C_LCD_SendString(char *str) {
    while (*str) {
        I2C_LCD_SendData(*str++);
    }
}

void I2C_LCD_SetCursor(uint8_t row, uint8_t col) {
    uint8_t position = 0x80;
    switch (row) {
        case 0: position += col; break;
        case 1: position += col + LCD_WIDTH; break;
        case 2: position += col + 0x14; break;
        case 3: position += col + 0x54; break;
        default: break;
    }
    I2C_LCD_SendCommand(position);
}

void I2C_LCD_Clear(void) {
    I2C_LCD_SendCommand(0x01); // Clear display command
    HAL_Delay(2); // Delay for clear command execution
}
